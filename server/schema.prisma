datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER       // Tizim egasi (Adminlarni va bo'limlarni boshqaradi)
  ADMIN       // Adminlar (Asad, A'lo)
  WORKER      // Bo'lim xodimlari (Nonchi, Kolbasachi...)
  USER        // Oddiy xaridorlar
}

enum Department {
  NON
  KOLBASACHI
  MEVA_SABZAVOT
  GOST
  ICHIMLIKLAR
}

enum ProductStatus {
  PENDING     // Xodim qo'shgan, admin tasdiqlashi kutilmoqda
  APPROVED    // Admin tasdiqlagan (Mini App katalogida ko'rinadi)
  REJECTED    // Rad etilgan
}

model User {
  id              String       @id @default(uuid())
  telegramId      BigInt       @unique
  phone           String?
  firstName       String?
  role            Role         @default(USER)
  department      Department?
  language        String       @default("uz")

  // Audit va moderatsiya bog'lanishlari
  createdProducts Product[]    @relation("WorkerCreatedProducts")
  approvedProducts Product[]   @relation("AdminApprovedProducts")
  acceptedOrders  Order[]      @relation("AdminAcceptedOrders")

  createdAt       DateTime     @default(now())
}

model Product {
  id           String        @id @default(uuid())
  titleUz      String
  titleRu      String
  price        Float
  image        String
  department   Department
  status       ProductStatus @default(PENDING)

  authorId     String
  author       User          @relation("WorkerCreatedProducts", fields: [authorId], references: [id])

  approvedById String?
  approvedBy   User?         @relation("AdminApprovedProducts", fields: [approvedById], references: [id])

  createdAt    DateTime      @default(now())
}

model Order {
  id           String        @id @default(uuid())
  userId       String
  totalAmount  Float
  status       String        @default("PENDING")

  acceptedById String?
  acceptedBy   User?         @relation("AdminAcceptedOrders", fields: [acceptedById], references: [id])

  createdAt    DateTime      @default(now())
}
